# Local e2e environment (PLAN 2026-11-05 §5.2). Copy to .env.e2e (gitignored):
#   cp .env.e2e.example .env.e2e
# Everything here is a TEST value. scripts/e2e-db.mjs refuses to run unless both
# database URLs point to the local cluster on 127.0.0.1:54329, and unless every key of
# .env (production) also exists here with a value, so nothing is inherited from it.

# Local PostgreSQL cluster created by `npm run e2e:db -- start` (trust auth, no password).
# Postgres on Windows starts one process per connection; on a busy machine that can take
# 10-20 s, hence the generous connect/pool timeouts (Prisma's defaults are 5 s and 10 s).
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/arcana_e2e?connect_timeout=60&pool_timeout=60
DIRECT_URL=postgresql://postgres@127.0.0.1:54329/arcana_e2e?connect_timeout=60

# Auth.js: same secret under both names; http on localhost:3000 (next start).
AUTH_SECRET=e2e-local-secret-not-for-production-0123456789abcdef
NEXTAUTH_SECRET=e2e-local-secret-not-for-production-0123456789abcdef
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Google sign-in is off in e2e.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Payments and email: test-shaped placeholders that no real service accepts.
STRIPE_SECRET_KEY=sk_test_e2e
STRIPE_WEBHOOK_SECRET=whsec_e2e
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_e2e
RESEND_API_KEY=re_e2e
CRON_SECRET=e2e

# AI: fixed answers (src/lib/ai/config.ts, never on Vercel) and an invalid key as a second lock.
ARCANA_AI_FAKE=1
ANTHROPIC_API_KEY=sk-ant-e2e-invalid

# Supabase keys exist in production's .env (not used by the app code); placeholders here
# so they are never inherited from it. 127.0.0.1:9 is the discard port: nothing answers.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9
NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-placeholder
SUPABASE_SERVICE_ROLE_KEY=e2e-placeholder

# prisma/seed.ts only wipes with this flag AND a localhost DATABASE_URL.
ARCANA_SEED_ALLOW_WIPE=1

# The e2e build goes to its own folder (next.config.ts distDir) and never touches .next.
ARCANA_DIST_DIR=.next-e2e
